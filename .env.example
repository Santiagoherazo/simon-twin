# Copia este archivo a .env y cambia TODAS las contraseñas.
# Genera valores fuertes con:  openssl rand -base64 24
# No subas .env al repositorio.

POSTGRES_PASSWORD=cambia-esto-1

# Usuarios MQTT (el nombre de usuario del dispositivo = su device_id)
MQTT_BACKEND_PASSWORD=cambia-esto-2
MQTT_SIM_PASSWORD=cambia-esto-3
MQTT_ESP32_PASSWORD=cambia-esto-4
MQTT_VIEWER_PASSWORD=cambia-esto-5

# Clave para los endpoints que mandan comandos (cabecera X-API-Key)
API_KEY=cambia-esto-6

GRAFANA_PASSWORD=cambia-esto-7

# Simulador
SIM_INTERVAL_SECONDS=5
SIM_BACKFILL_DAYS=14
SIM_AUTO_IRRIGATE_LIVE=false

# Respaldo en Supabase (opcional): Project Settings → Database → Connection string (Session pooler)
# Ej.: postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
