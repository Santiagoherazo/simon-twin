# Copia a .env (o .env.local) para cambiar los valores. Los defaults sirven para desarrollo local.
# Ojo: todo VITE_* queda incrustado en el JS que descarga el navegador; no pongas secretos reales aquí.
VITE_API_URL=http://127.0.0.1:8000
VITE_MQTT_URL=ws://127.0.0.1:9001
VITE_MQTT_USER=viewer
VITE_MQTT_PASS=pwv
VITE_DEFAULT_DEVICE=sim-01
